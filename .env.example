# --- LLM (необязательно) ---
PADEL_LLM_PROVIDER=none          # none | anthropic | openai
# ANTHROPIC_API_KEY=sk-ant-...
# PADEL_LLM_MODEL=claude-sonnet-4-5

# --- канал по умолчанию ---
PADEL_CHANNEL=console            # console | whatsapp | sms | telegram
PADEL_DRY_RUN=1                  # 1 = не дёргать внешние API, но считать стоимость

